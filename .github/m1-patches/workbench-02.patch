+}
+
+function workbenchBlockReason(input: {
+  id: DrinkMenuId;
+  validation: ReturnType<typeof validateCraftDrink>;
+  shots: number;
+  beans: number;
+}): string | undefined {
+  const recipe = recipeDefinition(input.id);
+  const { validation } = input;
+  if (validation.canCraft) return undefined;
+  if (!validation.recipeUnlocked) {
+    return recipe.shopAvailability === "timeWindow"
+      ? "시간대 상점에서 먼저 레시피를 발견해야 해요."
+      : `레벨 ${recipe.levelRequired}에서 레시피가 열려요.`;
+  }
+  if (!validation.recipePurchased) {
+    return recipe.shopAvailability === "timeWindow"
+      ? "떠돌이 판매상에서 레시피를 먼저 구매해 주세요."
+      : "상점에서 레시피를 먼저 구매해 주세요.";
+  }
+  if (!validation.shotsOk) {
+    return `에스프레소 샷이 부족해요 · ${input.shots}/${recipe.shots}`;
+  }
+  if (!validation.beansOk) {
+    return `원두가 부족해요 · ${input.beans}/${recipe.beans}`;
+  }
+  if (!validation.materialsOk) {
+    return `재료가 부족해요 · ${validation.missingMaterials
+      .map((item) => `${item.name} ${item.have}/${item.need}`)
+      .join(", ")}`;
+  }
+  return "현재는 제작할 수 없어요.";
+}
 
